# Local secrets for `wrangler dev` (npm run dev). Copy this file to .dev.vars and
# fill it in. .dev.vars is git-ignored. This .example file is the
# committed template.
#
# In production you set these values as Wrangler secrets instead
# (npx wrangler secret put PROXY_TOKEN), not from this file.

# Shared secret the proxy requires on every request (the widget sends it as
# ?key=). Pick any hard-to-guess string. The widget's PROXY_KEY in
# radar-widget/.env must match it. Without the secret the Worker fails closed and
# returns 401.
PROXY_TOKEN=dev-local-token
