# Secrets baked into the build by build.sh / run-sim.sh (copy to .env and fill in).
# .env is gitignored. Both keys are optional; if omitted, the defaults in
# resources/shared/properties.xml are used. Values are substituted into the build only
# and the file is restored afterward, so nothing secret is committed.

# Cloudflare Worker proxy base URL (no trailing slash).
PROXY_BASE=https://jma-rain-radar-proxy.YOURNAME.workers.dev

# Shared secret matching the proxy's PROXY_TOKEN (sent as ?key=).
PROXY_KEY=
