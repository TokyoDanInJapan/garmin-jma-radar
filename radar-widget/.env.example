# Secrets that build.sh and run-sim.sh bake into the build. Copy this file to
# .env and fill it in. .env is git-ignored. Both keys are optional. If you omit a
# key, the build uses the default in resources/shared/properties.xml. The scripts
# bake the values into a temporary copy of the resources for one build only, so
# nothing secret reaches a tracked file.

# Cloudflare Worker proxy base URL (no trailing slash).
PROXY_BASE=https://jma-rain-radar-proxy.YOURNAME.workers.dev

# Shared secret that matches the proxy's PROXY_TOKEN (sent as ?key= on /tile and
# as the X-Proxy-Key header on /frames).
PROXY_KEY=
