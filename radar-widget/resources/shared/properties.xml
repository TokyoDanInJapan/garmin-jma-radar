<?xml version="1.0" encoding="utf-8"?>
<!--
  Persistent app properties (defaults). The user edits them from Garmin Connect
  or the Connect IQ app through settings.xml. The app reads them at run time
  through Application.Properties.
-->
<properties>
    <!-- Your deployed Cloudflare Worker base URL (no trailing slash). -->
    <property id="proxyBase" type="string">https://jma-rain-radar-proxy.YOURNAME.workers.dev</property>
    <!-- Shared secret that matches the proxy's PROXY_TOKEN. Sent as ?key=. -->
    <property id="proxyKey" type="string"></property>
    <!-- Tile zoom: 4 (widest) to 11 (street). There are no JMA or GSI tiles
         past 11. Default 8, which is Local. The on-screen buttons pick 6 (Wide)
         or 8 (Local). -->
    <property id="zoom" type="number">8</property>
    <!-- Animation frames to request, 1 to 6. Six is the maximum, because a
         seventh frame makes the device run out of memory. Six is also the Wi-Fi
         maximum: on Wi-Fi every frame loads fast. Over Bluetooth the app
         throttles itself to 3 (BLE_FRAME_CAP), because image pulls are very slow
         there (about 27 s each through Garmin's image service). The proxy keeps
         the highest-priority frames: now, then +60, +30, +45, +15, -15. -->
    <property id="frameCount" type="number">6</property>
</properties>
