<?xml version="1.0" encoding="utf-8"?>
<!--
  Persistent app properties (defaults). The proxy URL and key match the radar
  app's. build.sh bakes them in from ../radar-widget/.env, so the dev build needs
  no manual setup. For Store installs the user can edit them from Garmin Connect
  (see settings.xml).
-->
<properties>
    <property id="proxyBase" type="string">https://jma-rain-radar-proxy.YOURNAME.workers.dev</property>
    <property id="proxyKey" type="string"></property>
</properties>
